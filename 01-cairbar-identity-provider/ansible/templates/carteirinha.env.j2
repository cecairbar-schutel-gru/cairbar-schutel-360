# {{ ansible_managed }}
# Serviço de Carteirinha (card-service). Variáveis documentadas em card-service/.env.example.
APP_ENVIRONMENT="{{ ambiente }}"
HOST="{{ carteirinha_http_host }}"
PORT="{{ carteirinha_http_port }}"
LOG_LEVEL="{{ carteirinha_log_level }}"
NODE_ENV="production"
# A senha vai em PGPASSWORD (lida pelo driver pg) para não precisar ser codificada na URL.
DATABASE_URL="postgres://{{ carteirinha_db_user }}@{{ keycloak_db_host }}:{{ postgresql_port }}/{{ carteirinha_db_name }}"
PGPASSWORD="{{ carteirinha_db_password }}"
KEYCLOAK_ISSUER="{{ keycloak_hostname }}/realms/{{ keycloak_realm }}"
KEYCLOAK_INTERNAL_URL="http://127.0.0.1:{{ keycloak_http_port }}"
KEYCLOAK_AUDIENCE="{{ carteirinha_keycloak_client_id }}"
KEYCLOAK_ALLOWED_CLIENTS="{{ carteirinha_allowed_clients | join(',') }}"
KEYCLOAK_CLIENT_ID="{{ carteirinha_keycloak_client_id }}"
KEYCLOAK_CLIENT_SECRET="{{ carteirinha_keycloak_client_secret }}"
KEYCLOAK_GCP_CLIENT_ID="{{ carteirinha_gcp_client_id }}"
KEYCLOAK_GCP_CLIENT_SECRET="{{ carteirinha_gcp_client_secret }}"
GCP_WIF_PROVIDER="{{ gcp_wif_provider }}"
GOOGLE_WALLET_ISSUER_ID="{{ carteirinha_google_wallet_issuer_id }}"
GOOGLE_WALLET_SERVICE_ACCOUNT="{{ carteirinha_google_wallet_service_account }}"
GOOGLE_WALLET_ISSUER_NAME="{{ carteirinha_google_wallet_issuer_name }}"
GOOGLE_WALLET_BACKGROUND_COLOR="{{ carteirinha_google_wallet_background_color }}"
GOOGLE_WALLET_ASSETS_BASE_URL="{{ carteirinha_google_wallet_assets_base_url }}"
GOOGLE_WALLET_CONTACT_TEXT="{{ carteirinha_google_wallet_contact_text }}"
