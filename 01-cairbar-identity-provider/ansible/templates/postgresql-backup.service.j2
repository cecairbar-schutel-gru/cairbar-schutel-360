# {{ ansible_managed }}
[Unit]
Description=Backup dos bancos PostgreSQL das aplicações
After=postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
User=postgres
Group=postgres
ExecStart=/usr/local/bin/postgresql-backup.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
