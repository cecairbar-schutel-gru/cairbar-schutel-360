# {{ ansible_managed }}
JAVA_HOME={{ java_home }}
JAVA_OPTS_KC_HEAP="{{ keycloak_heap_opts }}"
KC_DB_PASSWORD="{{ keycloak_db_password }}"
# Usados apenas na primeira inicialização (master sem admin): criam o admin
# temporário da console e o cliente de serviço temporário da automação.
KC_BOOTSTRAP_ADMIN_USERNAME="{{ keycloak_admin_user }}"
KC_BOOTSTRAP_ADMIN_PASSWORD="{{ keycloak_admin_password }}"
KC_BOOTSTRAP_ADMIN_CLIENT_ID="{{ keycloak_automation_client_id }}"
KC_BOOTSTRAP_ADMIN_CLIENT_SECRET="{{ keycloak_automation_client_secret }}"
