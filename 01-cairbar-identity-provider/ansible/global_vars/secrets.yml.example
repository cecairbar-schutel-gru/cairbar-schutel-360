---
# Copie para global_vars/secrets-<ambiente>.yml (ex.: secrets-dev.yml, secrets-qas.yml) e defina as senhas. O arquivo fica fora do
# controle de versão (.gitignore) e não é criptografado: restrinja as permissões
# (chmod 600) e não o compartilhe.
# Evite aspas duplas e barras invertidas nas senhas (vão para um EnvironmentFile do systemd).
# Use valores diferentes em cada ambiente (dev/qas/hml/prd) — nunca compartilhe segredos.
secret_postgresql_keycloak_password: "trocar-senha-keycloak"
secret_keycloak_admin_password: "trocar-senha-admin-keycloak"
# Segredo do cliente de serviço usado pelo playbook keycloak-realm.yml (mínimo 32 caracteres).
secret_keycloak_automation_client_secret: "trocar-segredo-cliente-automacao"
# Cliente OAuth "Aplicativo da Web" do Google (login com Google no realm), um por
# ambiente. O client ID não é sigiloso, mas fica aqui por variar com o ambiente.
# Opcional: sem os dois (ou vazios), o realm fica sem o botão "Entrar com Google".
secret_keycloak_google_client_id: "trocar-client-id.apps.googleusercontent.com"
secret_keycloak_google_client_secret: "trocar-segredo-cliente-google"
# Serviço de Carteirinha: senha do banco "carteirinha" e segredo do cliente de serviço
# servico-carteirinha no realm (mínimo 32 caracteres).
secret_postgresql_carteirinha_password: "trocar-senha-carteirinha"
secret_keycloak_carteirinha_client_secret: "trocar-segredo-cliente-carteirinha"
# Google Wallet: Issuer ID (Google Pay & Wallet Console, não é o Merchant ID) e e-mail da
# conta de serviço com a Google Wallet API habilitada (convidada como Desenvolvedor no Pay &
# Wallet Console). Não se cria chave para a conta. Um por ambiente; não são sigilosos.
secret_google_wallet_issuer_id: "0000000000000000000"
secret_google_wallet_service_account_email: "keycloak-srv-acc@comunidade-cairbar-512319.iam.gserviceaccount.com"
# Workload Identity Federation: provedor OIDC do pool que confia no realm deste ambiente
# (nome completo do recurso, não é sigiloso) e segredo do cliente servico-carteirinha-gcp
# do realm (mínimo 32 caracteres), cujo token o Google troca pelo da conta de serviço.
secret_gcp_wif_provider: "projects/000000000000/locations/global/workloadIdentityPools/cecairbar-dev/providers/keycloak"
secret_keycloak_carteirinha_gcp_client_secret: "trocar-segredo-cliente-carteirinha-gcp"
# Segredos dos clientes confidenciais das aplicações web do realm (keycloak_apps em
# global_vars/main.yml), mínimo 32 caracteres. Obrigatórios só para os apps com hostname
# no inventário; configure o mesmo valor no app.
secret_keycloak_durvalcrm_client_secret: "trocar-segredo-cliente-durvalcrm"
secret_keycloak_sgb_client_secret: "trocar-segredo-cliente-sgb"
