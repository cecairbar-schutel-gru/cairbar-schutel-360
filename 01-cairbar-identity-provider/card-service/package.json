{
    "name": "cecairbar-card-service",
    "version": "0.1.0",
    "description": "Serviço de Carteirinha do CE Cairbar Schutel Guarulhos (emissão de passes de carteira digital)",
    "type": "module",
    "private": true,
    "license": "UNLICENSED",
    "engines": {
        "node": ">=22.0.0"
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "start": "node dist/server.js",
        "migrate": "node dist/migrate.js",
        "dev": "tsx watch src/server.ts",
        "typecheck": "tsc --noEmit",
        "test": "vitest run"
    },
    "dependencies": {
        "fastify": "^5.12.7",
        "google-auth-library": "^11.3.1",
        "jose": "^6.2.13",
        "pg": "^8.23.1"
    },
    "devDependencies": {
        "@types/node": "^22.20.5",
        "@types/pg": "^8.23.1",
        "tsx": "^4.23.15",
        "typescript": "~5.9.0",
        "vitest": "^5.0.5"
    }
}
