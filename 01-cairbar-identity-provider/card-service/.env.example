# Serviço de Carteirinha — variáveis de ambiente (src/config.ts). Em produção o Ansible gera
# /etc/carteirinha/carteirinha.env (templates/carteirinha.env.j2). Copie para .env e preencha;
# o .env não vai para o git.

APP_ENVIRONMENT=dev
HOST=127.0.0.1
PORT=8280
LOG_LEVEL=info

DATABASE_URL=postgres://carteirinha@127.0.0.1:5432/carteirinha
PGPASSWORD=

# Issuer público dos tokens do portal e URL interna do Keycloak (JWKS e Admin API).
KEYCLOAK_ISSUER=https://<host>/realms/cecairbar
KEYCLOAK_INTERNAL_URL=http://127.0.0.1:8180
KEYCLOAK_AUDIENCE=servico-carteirinha
KEYCLOAK_ALLOWED_CLIENTS=account-console
KEYCLOAK_CLIENT_ID=servico-carteirinha
KEYCLOAK_CLIENT_SECRET=

# Google Cloud por Workload Identity Federation (sem chave de conta de serviço): cliente do
# realm cujo token o STS do Google aceita e nome completo do provedor OIDC do pool.
KEYCLOAK_GCP_CLIENT_ID=servico-carteirinha-gcp
KEYCLOAK_GCP_CLIENT_SECRET=
GCP_WIF_PROVIDER=projects/<número-do-projeto>/locations/global/workloadIdentityPools/<pool>/providers/<provedor>

# Google Wallet: Issuer ID do Google Pay & Wallet Console e e-mail da conta de serviço
# convidada no console (personificada pela federação).
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SERVICE_ACCOUNT=keycloak-srv-acc@comunidade-cairbar-512319.iam.gserviceaccount.com
GOOGLE_WALLET_ISSUER_NAME=CE Cairbar Schutel Guarulhos
GOOGLE_WALLET_BACKGROUND_COLOR=#FFFFFF
# URL pública HTTPS (certificado válido) de /api/v1/cards/assets; vazia = passe sem imagens.
GOOGLE_WALLET_ASSETS_BASE_URL=
# TODO(seção 9.2): texto de devolução/contato em caso de uso indevido.
GOOGLE_WALLET_CONTACT_TEXT=
