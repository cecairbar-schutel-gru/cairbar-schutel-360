        "i18next-fetch-backend": "^7.0.0",
        "keycloakify": "^11.16.0",
        "lodash-es": "^4.18.1",
        "oidc-spa": "~10.2.17",
        "react": "18.3.1",
        "react-dom": "18.3.1",
