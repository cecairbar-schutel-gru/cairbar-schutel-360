# Copie para .env (ignorado pelo git). Valores para o compose.yaml local.
# Em produção, os segredos vêm do vault do ansible.

# Conexão administrativa (realm master). Use usuário/senha OU client credentials.
KEYCLOAK_URL=http://localhost:8180
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin
# KEYCLOAK_ADMIN_CLIENT_ID=booksys-provisioner
# KEYCLOAK_ADMIN_CLIENT_SECRET=

# Realm compartilhado (realm, perfis e grupos vêm de 01-cairbar-identity-provider)
BOOKSYS_REALM=cecairbar
# Origens da SPA, separadas por vírgula (redirect, web origin e pós-logout)
BOOKSYS_WEB_URLS=http://localhost:5173
# Segredo do client booksys-api (o backend usa na service account)
BOOKSYS_API_CLIENT_SECRET=troque-este-segredo
