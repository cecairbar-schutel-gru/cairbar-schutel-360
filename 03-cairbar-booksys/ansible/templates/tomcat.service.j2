# {{ ansible_managed }}
[Unit]
Description=Apache Tomcat {{ tomcat_version }} (Sistema de Biblioteca - SGB)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ tomcat_user }}
Group={{ tomcat_user }}
Environment=CATALINA_HOME={{ tomcat_home }}
Environment=CATALINA_BASE={{ tomcat_base }}
ExecStart={{ tomcat_home }}/bin/catalina.sh run
SuccessExitStatus=143
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
