# {{ ansible_managed }}
# Site do DurvalCRM no nginx instalado por 01-cairbar-identity-provider (mapa em
# ../../esquema-navegacao.png): {{ durvalcrm_hostname }} -> Tomcat. O login é no realm
# cecairbar pelo hostname do Keycloak ({{ cecairbar_keycloak_url }}).
# Log, correlation ID e snippets cairbar-*.conf vêm da base da solução 01.

upstream durvalcrm {
    server {{ durvalcrm_upstream }};
    keepalive 16;
}

# HTTP: desafio ACME e redirect para HTTPS.
server {
    listen 80;
    listen [::]:80;
    server_name {{ durvalcrm_hostname }};
    access_log /var/log/nginx/durvalcrm-access.log cairbar_json;

    include snippets/cairbar-acme.conf;

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    # Sintaxe compatível com o nginx do Ubuntu 22.04/24.04 (< 1.25).
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name {{ durvalcrm_hostname }};

    ssl_certificate     {{ nginx_tls_cert }};
    ssl_certificate_key {{ nginx_tls_key }};
    include snippets/cairbar-tls.conf;
{% if nginx_tls_cert.startswith("/etc/letsencrypt/") %}
    add_header Strict-Transport-Security "max-age=31536000" always;
{% endif %}

    access_log /var/log/nginx/durvalcrm-access.log cairbar_json;
    include snippets/cairbar-proxy.conf;

    # Anexos das intenções de gasto e importações de histórico.
    client_max_body_size {{ durvalcrm_client_max_body_size }};

    location / {
        proxy_pass http://durvalcrm;
    }
}
